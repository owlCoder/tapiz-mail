<?xml version="1.0" encoding="utf-8"?>
<!--
  Dozvoljava cleartext samo ka 10.0.2.2 (PC localhost iz AVD emulatora) — koristan
  samo za test-IMAP servere tokom razvoja. Produkcija (stvarni IMAP/SMTP hostovi)
  ide preko TLS-a/STARTTLS-a, ovaj fajl to ne menja.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
