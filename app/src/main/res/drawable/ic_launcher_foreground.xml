<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Tapiz Mail icon: modern outline envelope, smaller and lighter than the original
      filled mark (44x33 body vs. the old 60x44, stroke-only vs. solid fill) so it reads
      as a crisp glyph with breathing room rather than a heavy block filling the safe
      zone. No product yet has this glyph assigned as a @tapizlabs/ui LogoMark variant —
      add "mail" there when the design system gets its Tapiz Mail entry.
    -->

    <!-- Envelope body: rounded rect outline, 32..76 x, 37..70 y (44x33), rx 7, stroke 4.5 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M39,37 H69 A7,7 0 0 1 76,44 V63 A7,7 0 0 1 69,70 H39 A7,7 0 0 1 32,63 V44 A7,7 0 0 1 39,37 Z" />
    <!-- Open-flap fold, same stroke weight/cap so it reads as one continuous line drawing -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M34.5,41 L54,56 L73.5,41" />
</vector>
